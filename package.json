{
  "name": "content-agent",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "bot": "node --experimental-strip-types src/telegram-bot.ts",
    "bot:dev": "node --experimental-strip-types --watch src/telegram-bot.ts",
    "bot:pm2": "pm2 start ecosystem.config.js",
    "bot:pm2:stop": "pm2 stop content-agent-bot",
    "bot:pm2:restart": "pm2 restart content-agent-bot",
    "bot:pm2:logs": "pm2 logs content-agent-bot",
    "bot:pm2:delete": "pm2 delete content-agent-bot",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:watch": "node --experimental-strip-types --test --watch test/*.test.ts",
    "doctor": "node --experimental-strip-types src/index.ts doctor",
    "video": "node --experimental-strip-types src/index.ts video",
    "post": "node --experimental-strip-types src/index.ts post",
    "calendar": "node --experimental-strip-types src/index.ts calendar"
  },
  "dependencies": {
    "@grammyjs/files": "^1.2.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}