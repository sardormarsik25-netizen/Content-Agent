# Telegram Bot Configuration (REQUIRED)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Optional: Admin and Channel IDs for admin features
ADMIN_ID=123456789
CHANNEL_ID=-1001234567890

# OpenCode / AI Model Configuration
CONTENT_AGENT_MODEL=opencode/big-pickle
CONTENT_AGENT_AGENT=content-agent
CONTENT_AGENT_TIMEOUT_MS=300000

# Optional: Override OpenCode binary path if not in PATH
# OPENCODE_BIN=C:\Users\user\AppData\Roaming\npm\opencode.cmd

# Optional: Debug logging
# CONTENT_AGENT_DEBUG=1

# Optional: Brand profile path (defaults to config/brand-profile.json)
# BRAND_PROFILE_PATH=config/brand-profile.json